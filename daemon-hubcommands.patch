+#ifndef DCPLUSPLUS_WEBSERVER_HUB_COMMAND_MENU_PROVIDER_H
+#define DCPLUSPLUS_WEBSERVER_HUB_COMMAND_MENU_PROVIDER_H
+
+#include "forward.h"
+
+#include "ContextMenuItem.h"
+#include "ContextMenuManagerListener.h"
+
+#include <airdcpp/core/ActionHook.h>
+#include <airdcpp/hub/user_command/UserCommand.h>
+
+namespace webserver {
+
+class ContextMenuManager;
+
+// Exposes the hub user commands (the ones sent by hubs and the ones added by the user)
+// in the "hub" (hub context) and "hub_user" (user context) context menus.
+class HubCommandMenuProvider : private ContextMenuManagerListener {
+public:
+	static const string HOOK_ID;
+
+	explicit HubCommandMenuProvider(ContextMenuManager& aManager);
+	~HubCommandMenuProvider() override;
+
+	HubCommandMenuProvider(const HubCommandMenuProvider&) = delete;
+	HubCommandMenuProvider& operator=(const HubCommandMenuProvider&) = delete;
+
+	// Names of the input prompts (%[line:xxx], %[kickline:xxx]) of a command, in order of appearance
+	static StringList parsePromptParams(const string& aCommand) noexcept;
+private:
+	using ResultGetter = ActionHookResultGetter<GroupedContextMenuItemPtr>;
+	using HookResult = ActionHookResult<GroupedContextMenuItemPtr>;
+
+	HookResult onListHubMenu(const vector<ClientToken>& aSelections, const ContextMenuItemListData& aListData, const ResultGetter& aResultGetter) noexcept;
+	HookResult onListHubUserMenu(const vector<dcpp::SID>& aSelections, const ContextMenuItemListData& aListData, const ClientPtr& aClient, const ResultGetter& aResultGetter) noexcept;
+
+	HookResult getMenu(int aContext, const ClientPtr& aClient, const ResultGetter& aResultGetter) noexcept;
+
+	void on(HubMenuSelected, const vector<ClientToken>& aSelectedIds, const ContextMenuItemClickData& aClickData) noexcept override;
+	void on(HubUserMenuSelected, const vector<dcpp::SID>& aSelectedIds, const ClientPtr& aClient, const ContextMenuItemClickData& aClickData) noexcept override;
+
+	static bool parseCommandId(const string& aMenuItemId, int& id_) noexcept;
+	static void fillPromptParams(const UserCommand& aCommand, const ContextMenuItemClickData& aClickData, ParamMap& params_) noexcept;
+
+	ContextMenuManager& manager;
+};
+
+} // namespace webserver
+
+#endif // DCPLUSPLUS_WEBSERVER_HUB_COMMAND_MENU_PROVIDER_H
